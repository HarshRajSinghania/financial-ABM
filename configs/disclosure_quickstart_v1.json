{
  "name": "disclosure_quickstart_v1",
  "purpose": "development",
  "_note": "Quickstart: three policies on a small market (200 investors, 40 firms, 2,400 trading days, 4 seeds); about 10 seconds on a laptop. Market settings follow stage F at reduced scale; the domain is the bundled, uncalibrated ESG file, because the stage F domain is built from vendor data that is not distributed. Fines start at zero so firms have a reason to greenwash. The numbers are a demonstration of the pipeline, not research results. Try it: change transparency 0.6 to 0.3 in scenario I and run into a new output directory; transparency then falls below the threshold and the information policy loses most of its effect.",
  "domain": "domains/esg.json",
  "market": {
    "n_investors": 200,
    "n_firms": 40,
    "trading_days": 2400,
    "burn_in_days": 1200,
    "initial_impact_share": 0.2,
    "taste_median": 0.0724,
    "imitation_rule": "pairwise",
    "financing_exposure_fraction": 0.5,
    "financing_spread": 0.05,
    "financing_repricing_interval": 60,
    "financing_horizon_days": 1260,
    "firm_discount_rate": 0.05,
    "intrinsic_value_log_sd": 0.9151544344205937
  },
  "seeds": [
    90001,
    90002,
    90003,
    90004
  ],
  "scenarios": [
    {
      "name": "B",
      "policy": {
        "baseline": {
          "penalty": 0.0
        }
      }
    },
    {
      "name": "I",
      "policy": {
        "baseline": {
          "penalty": 0.0
        },
        "start_day": 1201,
        "changes": {
          "transparency": 0.6
        }
      }
    },
    {
      "name": "F",
      "policy": {
        "baseline": {
          "penalty": 0.0
        },
        "start_day": 1201,
        "changes": {
          "penalty": 0.02
        }
      }
    }
  ],
  "comparisons": [
    {
      "name": "information_minus_baseline",
      "weights": {
        "I": 1,
        "B": -1
      },
      "primary": true
    },
    {
      "name": "penalty_minus_baseline",
      "weights": {
        "F": 1,
        "B": -1
      }
    },
    {
      "name": "information_minus_penalty",
      "weights": {
        "I": 1,
        "F": -1
      }
    }
  ],
  "analysis": {
    "primary_metric": "true_change.equal_weight_sd",
    "metrics": [
      "true_change.equal_weight_sd",
      "inflation.mean_sd",
      "size.large_minus_small_sd"
    ],
    "confidence_level": 0.95
  }
}
