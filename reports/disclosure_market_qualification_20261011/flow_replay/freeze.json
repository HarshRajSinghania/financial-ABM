  "instrumentation": {
    "u": "At the price_moves entry, u=price_impact*net_flow_value/(liquidity_fraction*market_cap), using the actual submitted monetary flow and actual reference prices. Preserve each float64 u from day1 through3500.",
    "source_call": "Call the original Recorder-wrapped price_moves exactly once; do not alter state, orders or RNG. The original Recorder is reused for bitwise comparison of all23 original NPZ arrays.",
    "temporary_memory": "After each quote copy the source book EMA and transient state into RAM for independent offline recursion checks. These states and duplicate original paths are not written as new full-path archives.",
    "output": "One u-only NPZ per replay, plus small per-world statistics/verification JSON and aggregate report/manifest. On interruption save only the observed input prefix and distinguish quoted/completed steps."
  },
  "verification": {
    "bitwise": "All23 original NPZ arrays, including P/V, raw/moves/depth, cap, cash/share diagnostics, flags, RNG digests, event snapshots and both moment matrices; dtype, shape and contiguous bytes must match. Also compare recorded initialization/schedule hashes and the original fingerprint when available.",
    "early": "Compare actual reference P, current V, quote outputs and reconstructed next P with the original path each day; stop immediately at the first detected mismatch.",
    "source_book": "Offline current EMA and transient recursion must match the replayed source book states byte-for-byte at every day/company. Preserve the original multiplication/division order.",
    "special_original_interruption": "m30_710107 retains its original failed diagnostic status. Its complete NPZ arrays must still match; the absent original complete result fingerprint is not reconstructed or invented.",
    "identity": "Before execution and after all replays verify the frozen files, all original JSON/NPZ hashes and52 source hashes. Recheck the current reference files and sources before each world."
  },
  "offline": {
    "initial_states": "Current m0=0, alternate q0=0, both T0=0, as in the archived bare book; use the whole3500-day u/depth history before measuring days1201..3500.",
    "current": "sI=u/d-m_prev; m=rho*m_prev+(1-rho)*u/d; TI=decay*TI_prev+(1-p)*sI",
    "alternative": "sF=(u-q_prev)/d; q=rho*q_prev+(1-rho)*u; TF=decay*TF_prev+(1-p)*sF",
    "common_unit_errors": "eI=u-d*m_prev and eF=u-q_prev; both are normalized submitted-flow errors, not differently scaled native surprise errors.",
    "metrics": [
      "MSE=mean(e^2)",
      "MAE=mean(abs(e))",
      "lag1 Pearson ACF, separately centering the two shifted series"
